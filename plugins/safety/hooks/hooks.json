{
  "description": "Safety guards for Claude Code: stop destructive commands, writes to the agent's own rules and secrets, data leaving the machine, destructive git, network-exposed servers, and hidden instructions in fetched content.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/command-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/config-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/egress-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/git-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/listen-bind-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/config-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/egress-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/guards/guard-run.sh\" \"${CLAUDE_PLUGIN_ROOT}/guards/ingress-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
